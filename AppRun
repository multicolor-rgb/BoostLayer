#!/bin/sh
# Development/AppDir entry point. build.sh generates the final AppRun too.
set -eu
APPDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export APPDIR
export PATH="$APPDIR/usr/bin:$PATH"
if [ -x "$APPDIR/usr/bin/boostlayer/boostlayer" ]; then
    exec "$APPDIR/usr/bin/boostlayer/boostlayer" "$@"
fi
exec "$APPDIR/usr/bin/boostlayer" "$@"
